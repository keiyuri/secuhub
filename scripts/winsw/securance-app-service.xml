<!--
  WinSW(https://github.com/winsw/winsw) 서비스 정의 — 레거시 SR_Speed_Server의
  ServiceBase/ProjectInstaller.cs 역할을 대체한다(계획서 7.1절).

  사용법:
    1. https://github.com/winsw/winsw/releases 에서 WinSW-x64.exe(또는 해당 아키텍처)를 내려받아
       이 파일과 같은 디렉터리에 `securance-app-service.exe`로 이름을 바꿔 둔다.
       (바이너리는 이 저장소에 포함하지 않는다 — 사용자가 직접 받아야 한다.)
    2. securance-app.jar을 이 파일과 같은 디렉터리(또는 <workingdirectory> 경로)에 둔다.
    3. scripts/install-service.ps1 실행 — install/start를 순서대로 수행한다.
-->
<service>
  <id>securance-app</id>
  <name>securance-app (secuhub)</name>
  <description>Securance 게이트 관리 백엔드 — TCP 연동/스케줄러/웹 대시보드 통합 서비스</description>

  <executable>java</executable>
  <arguments>-jar securance-app.jar --spring.profiles.active=prod</arguments>

  <workingdirectory>%BASE%</workingdirectory>

  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>30</keepFiles>
  </log>

  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>

  <startmode>Automatic</startmode>
  <stopparentprocessfirst>true</stopparentprocessfirst>
</service>
