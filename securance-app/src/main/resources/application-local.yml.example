# 로컬 개발용 설정 예시. `application-local.yml`로 복사해 실제 값을 채운 뒤 사용한다
# (application-local.yml은 .gitignore에 등록되어 있어 커밋되지 않는다 — 계획서 7.1절).
#
# 실행: java -jar securance-app.jar --spring.profiles.active=local
#   또는 ./gradlew.bat :securance-app:bootRun --args="--spring.profiles.active=local"

spring:
  datasource:
    url: jdbc:mariadb://db.example.internal:3306/securance_gate
    username: securance
    password: changeme

  # spring.flyway.url/user/password는 spring.datasource.*와 별개 프로퍼티지만,
  # FlywayDataSourceConfig(securance-domain)가 결국 spring.datasource.url/username/password를
  # 그대로 읽어 socketTimeout=600000(대용량 테이블 재구성 대비)만 덧붙인 뒤 Flyway 커넥션을
  # 재정의하므로, 아래 값은 위 datasource와 항상 같게 맞춰야 한다(코드 리뷰 지적 S-1, 2026-08-20:
  # base application.yml이 더 이상 실 개발 DB를 기본값으로 깔아두지 않으므로, 값을 비워두면
  # 예전처럼 다른 환경에 조용히 붙는 대신 환경변수 미설정과 동일하게 기동 자체가 실패한다).
  flyway:
    url: jdbc:mariadb://db.example.internal:3306/securance_gate?socketTimeout=600000&connectTimeout=3000
    user: securance
    password: changeme

securance:
  server:
    mode: SERVER
    # 버그 수정(2026-08-13, B2): 실제 게이트 장비 포트(base application.yml과 동일)로 정정.
    port: 28010
